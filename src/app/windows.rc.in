// The Windows resources of the game's executable: its icon (when the build
// is given one, SH_WINDOWS_ICON), its version information and its manifest.
// Generated by CMake from app/windows.rc.in.
#include <winver.h>

@SH_WINDOWS_ICON_RESOURCE@
1 24 "@SH_WINDOWS_MANIFEST@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @SH_VERSION_MAJOR@,@SH_VERSION_MINOR@,@SH_VERSION_PATCH@,0
PRODUCTVERSION @SH_VERSION_MAJOR@,@SH_VERSION_MINOR@,@SH_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "@SH_EDITION_PREF_ORG@"
      VALUE "FileDescription", "@SH_EDITION_NAME@"
      VALUE "FileVersion", "@SH_VERSION@"
      VALUE "InternalName", "@SH_EDITION_EXECUTABLE@"
      VALUE "LegalCopyright", "MIT License"
      VALUE "OriginalFilename", "@SH_EDITION_EXECUTABLE@.exe"
      VALUE "ProductName", "@SH_EDITION_NAME@"
      VALUE "ProductVersion", "@SH_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
